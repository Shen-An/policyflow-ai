# PolicyFlow AI configuration surface. Copy to .env and inject every secret at deploy time.
# Numeric defaults are safe starting points for development, not production capacity claims.

# Application profile: development | test | production
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO
# Required secret values are intentionally empty; use a secret manager in production.
SECRET_KEY=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=

# PostgreSQL is the only production SQL authority. This async URL omits its password
# intentionally; inject a complete secret-backed DATABASE_URL in production.
DATABASE_URL=postgresql+psycopg://policyflow@postgres:5432/policyflow
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# RabbitMQ transports Celery wake-up messages; PostgreSQL DurableJob/outbox remains
# authoritative. Inject an amqps:// broker URL from a secret and do not store results here.
CELERY_BROKER_URL=
CELERY_TASK_IGNORE_RESULT=true
CELERY_TASK_DEFAULT_QUEUE=policyflow.default
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true
CELERY_BROKER_CONNECTION_TIMEOUT_SECONDS=10
RABBITMQ_QUEUE_TYPE=quorum
RABBITMQ_QUEUE_MAX_LENGTH=10000
RABBITMQ_QUEUE_MAX_BYTES=268435456
RABBITMQ_DEAD_LETTER_QUEUE=policyflow.dead

# Redis is non-authoritative coordination, quota lease, and bounded SSE replay state.
# The development URL is credential-free; production must inject a secret rediss:// URL.
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=policyflow
REDIS_COORDINATION_PREFIX=coord
REDIS_SSE_STREAM_PREFIX=sse
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5

# Milvus is the only production vector authority. TLS must remain enabled in production.
MILVUS_URI=https://milvus:19530
MILVUS_TOKEN=
MILVUS_TLS_ENABLED=true
MILVUS_SERVER_NAME=milvus
MILVUS_DATABASE=policyflow
MILVUS_COLLECTION=policyflow_chunks
MILVUS_TENANT_PARTITION_KEY=tenant_id
MILVUS_REQUEST_TIMEOUT_SECONDS=30

# Versioned S3-compatible object storage is the only production file authority.
# Credentials are blank by design; use workload identity or secret injection.
OBJECT_STORE_PROVIDER=s3
OBJECT_STORE_ENDPOINT_URL=https://minio:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=policyflow-materials
OBJECT_STORE_VERSIONING_REQUIRED=true
OBJECT_STORE_TLS_ENABLED=true
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_SESSION_TOKEN=
OBJECT_STORE_CONNECT_TIMEOUT_SECONDS=10
OBJECT_STORE_READ_TIMEOUT_SECONDS=60

# OpenTelemetry exporter. Use http/protobuf with an OTLP HTTP endpoint.
OTEL_SERVICE_NAME=policyflow-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.10
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# gVisor sandbox policy. The Kubernetes Job policy must enforce these limits.
SANDBOX_RUNTIME_CLASS_NAME=gvisor
SANDBOX_NAMESPACE=policyflow-sandbox
SANDBOX_RESOURCE_POLICY_ID=restricted-v1
SANDBOX_NETWORK_POLICY=deny-all
SANDBOX_SERVICE_ACCOUNT_AUTOMOUNT=false
SANDBOX_CPU_LIMIT_MILLICORES=1000
SANDBOX_MEMORY_LIMIT_MIB=1024
SANDBOX_EPHEMERAL_STORAGE_LIMIT_MIB=2048
SANDBOX_PIDS_LIMIT=128
SANDBOX_ACTIVE_DEADLINE_SECONDS=300
SANDBOX_MAX_CONCURRENCY=8

# Admission, queue, lease, and SSE bounds. Tune only from retained load evidence.
QUOTA_GLOBAL_REQUESTS_PER_MINUTE=1200
QUOTA_TENANT_REQUESTS_PER_MINUTE=300
QUOTA_USER_REQUESTS_PER_MINUTE=60
QUOTA_GLOBAL_MAX_CONCURRENCY=100
QUOTA_TENANT_MAX_CONCURRENCY=20
QUOTA_USER_MAX_CONCURRENCY=4
QUOTA_GLOBAL_LLM_TOKENS_PER_MINUTE=1000000
QUOTA_TENANT_LLM_TOKENS_PER_MINUTE=200000
QUOTA_USER_LLM_TOKENS_PER_MINUTE=50000
QUOTA_GLOBAL_LLM_BUDGET_USD_CENTS_PER_DAY=10000
QUOTA_TENANT_LLM_BUDGET_USD_CENTS_PER_DAY=2000
QUOTA_USER_LLM_BUDGET_USD_CENTS_PER_DAY=500
ADMISSION_QUEUE_MAX_ITEMS=1000
ADMISSION_QUEUE_WAIT_TIMEOUT_SECONDS=5
QUOTA_LEASE_DURATION_SECONDS=120
QUOTA_LEASE_HEARTBEAT_SECONDS=30
SSE_CHANNEL_CAPACITY=128
SSE_REPLAY_MAX_EVENTS_PER_RUN=1000
SSE_REPLAY_TTL_SECONDS=3600
SSE_HEARTBEAT_SECONDS=15
SSE_SEND_TIMEOUT_SECONDS=10

# LLM execution mode: deterministic_mock | anthropic. Capacity tests must use
# deterministic_mock; real-provider tests require explicit credentials and budget.
LLM_EXECUTION_MODE=deterministic_mock
LLM_MOCK_VERSION=policyflow-mock-v1
LLM_MOCK_LATENCY_MILLISECONDS=100
# Stable comma-separated attempt:error pairs; leave empty for no injected errors.
LLM_MOCK_ERROR_SCRIPT=
LLM_MOCK_ARTIFACT_DIR=artifacts/load/mock
LLM_REAL_PROVIDER_ARTIFACT_DIR=artifacts/provider/anthropic

# Real Claude provider: official Anthropic SDK only. Do not add OpenAI-compatible
# endpoints or keys. ANTHROPIC_API_KEY is intentionally blank and must be injected
# as a secret; the SDK may alternatively resolve an approved Anthropic auth profile.
CLAUDE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_PROFILE=
CLAUDE_MODEL=claude-opus-5
CLAUDE_THINKING_TYPE=adaptive
CLAUDE_EFFORT=high
CLAUDE_STREAMING_ENABLED=true
CLAUDE_TIMEOUT_SECONDS=120
CLAUDE_MAX_OUTPUT_TOKENS=16000
CLAUDE_MAX_RETRIES=2
CLAUDE_MAX_CONCURRENCY=8
CLAUDE_REQUESTS_PER_MINUTE=60
CLAUDE_INPUT_TOKENS_PER_MINUTE=500000
CLAUDE_OUTPUT_TOKENS_PER_MINUTE=100000
CLAUDE_RUN_MAX_REQUESTS=16
CLAUDE_RUN_MAX_TOTAL_TOKENS=200000
CLAUDE_RUN_BUDGET_USD_CENTS=100
# Existing graph/chat deadline retained; it bounds all provider retries for one turn.
CHAT_TURN_TIMEOUT_SECONDS=180

# Development-only compatibility adapters. T005 must reject these as production
# authorities; production uses PostgreSQL, versioned object storage, and Milvus.
# Isolated tests may override DATABASE_URL=sqlite:///./policyflow.db explicitly.
UPLOAD_DIR=uploads
RAG_WORKSPACE_DIR=rag_workspaces
MAX_UPLOAD_SIZE_MB=20
LIGHTRAG_HYBRID_TIMEOUT_SECONDS=45

# Existing reranker integration; independent from the Claude provider.
NVIDIA_RERANKER_API_KEY_ENV=NVIDIA_API_KEY
NVIDIA_RERANKER_BASE_URL=https://ai.api.nvidia.com
NVIDIA_RERANKER_ENDPOINT_TEMPLATE=/v1/retrieval/{model}/reranking
NVIDIA_RERANKER_MODELS=nvidia/llama-nemotron-rerank-vl-1b-v2
NVIDIA_RERANKER_TIMEOUT_SECONDS=30
NVIDIA_RERANKER_TRUNCATE=END
