# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# Virtual envs
.venv/
venv/
env/

# Database
*.db
*.db-shm
*.db-wal
*.sqlite3
*.backup-*

# IDE
.idea/
.vscode/
*.swp
.obsidian/

# Environment
.env
.env.local
session.json
/1.py

# Log
*.log
logs/
# ...except evidence logs under artifacts/: they are the checked-in proof that the
# Stage 8 UI run and the acceptance / quickstart runs actually happened, so a fresh
# clone has to be able to read them. The bare ``*.log`` rule above would silently
# drop them from the repo (that is the "evidence hole" called out in the README).
!artifacts/**/*.log

# Runtime data
uploads/
rag_workspaces/

# Test artifacts
.pytest-tmp*/
.pytest_tmp*/
playwright-report/
test-results/
tmp_*/

# Personal documents (keep out of the repo)
docs/我的简历.pdf
*.resume.pdf

# Generated reports
docs/rehearsal-latest.json

# Claude
.claude/

# DSH session upload scratch
.dsh-uploads/
artifacts/acceptance/*.sqlite
